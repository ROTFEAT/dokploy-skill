#!/usr/bin/env python3
"""
dp — Dokploy deploy + poll + logs, plus diagnostics.

Usage:
  dp                            # deploy, poll, tail runtime logs
  dp --url=... --key=... --app=...
  dp --only-status              # print latest deployment status
  dp --only-logs [--log-tail=N] # tail runtime logs (app container)
  dp --db-logs   [--log-tail=N] [--postgres=ID]  # tail Postgres container logs
  dp --inspect                  # dump current application config
  dp --list                     # list latest 5 deployments
  dp --version                  # print local skill version
  dp --check-update             # compare local VERSION to GitHub (no git pull)

Search (runtime logs):
  dp --only-logs --search=ERROR   # client-side grep; avoids server-side 500 bug

Config (first win): CLI args → env vars → .env in CWD
  DOKPLOY_URL / DOKPLOY_API_KEY / DOKPLOY_APP_ID / DOKPLOY_POSTGRES_ID (optional)

Exit codes:
  0 = done / info ok
  1 = deploy error or HTTP error
  2 = missing config
  3 = poll timeout
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent


def load_dotenv(cwd: str) -> dict:
    cfg = {}
    p = Path(cwd) / ".env"
    if not p.exists():
        return cfg
    for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        cfg[k.strip()] = v.strip().strip('"').strip("'")
    return cfg


def resolve_config(args) -> dict:
    dotenv = load_dotenv(os.getcwd())

    def pick(*keys):
        for k in keys:
            v = os.environ.get(k) or dotenv.get(k)
            if v:
                return v
        return None

    return {
        "url": args.url or pick("DOKPLOY_URL"),
        "key": args.key or pick("DOKPLOY_API_KEY", "DKEY"),
        "app": args.app or pick("DOKPLOY_APP_ID", "APPLICATION_ID"),
        "postgres": args.postgres or pick("DOKPLOY_POSTGRES_ID"),
    }


def api(method: str, base: str, path: str, key: str, body=None, params=None, timeout: int = 30):
    url = base.rstrip("/") + "/api" + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode() if body is not None else None
    headers = {"x-api-key": key, "Accept": "application/json"}
    if body is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read().decode("utf-8", errors="replace")
            try:
                return r.status, json.loads(raw) if raw else None
            except json.JSONDecodeError:
                return r.status, raw
    except urllib.error.HTTPError as e:
        payload = e.read().decode("utf-8", errors="replace") if e.fp else ""
        return e.code, payload
    except urllib.error.URLError as e:
        return 0, str(e)


def fmt(payload) -> str:
    if payload is None:
        return "(empty)"
    if isinstance(payload, str):
        return payload or "(empty)"
    return json.dumps(payload, indent=2, ensure_ascii=False)


def filter_local(text: str, pattern: str | None) -> str:
    if not pattern or not isinstance(text, str):
        return text
    try:
        rx = re.compile(pattern, re.IGNORECASE)
    except re.error:
        rx = re.compile(re.escape(pattern), re.IGNORECASE)
    keep = [ln for ln in text.splitlines() if rx.search(ln)]
    return "\n".join(keep) if keep else f"(no match for {pattern!r})"


def need(cfg, *keys):
    missing = [k for k in keys if not cfg.get(k)]
    if missing:
        names = {
            "url": "DOKPLOY_URL",
            "key": "DOKPLOY_API_KEY",
            "app": "DOKPLOY_APP_ID",
            "postgres": "DOKPLOY_POSTGRES_ID",
        }
        print("MISSING_CONFIG: " + ",".join(names[m] for m in missing), file=sys.stderr)
        sys.exit(2)


def cmd_list(cfg, n: int = 5):
    need(cfg, "url", "key", "app")
    code, deps = api("GET", cfg["url"], "/deployment.all", cfg["key"], params={"applicationId": cfg["app"]})
    if code >= 300 or not isinstance(deps, list):
        print(f"list failed: HTTP {code} {deps}", file=sys.stderr)
        return 1
    print(f"--- latest {min(n, len(deps))} deployments ---")
    for d in deps[:n]:
        title = (d.get("title") or "").splitlines()[0][:70]
        print(f"{d.get('createdAt', '?')}  {d.get('status', '?'):7}  {d.get('deploymentId', '?')}  {title}")
    return 0


def cmd_only_status(cfg):
    need(cfg, "url", "key", "app")
    code, deps = api("GET", cfg["url"], "/deployment.all", cfg["key"], params={"applicationId": cfg["app"]})
    if code >= 300 or not isinstance(deps, list) or not deps:
        print(f"status failed: HTTP {code} {deps}", file=sys.stderr)
        return 1
    d = deps[0]
    print(json.dumps({
        "deploymentId": d.get("deploymentId"),
        "status": d.get("status"),
        "createdAt": d.get("createdAt"),
        "errorMessage": d.get("errorMessage"),
        "logPath": d.get("logPath"),
    }, indent=2, ensure_ascii=False))
    return 0 if d.get("status") == "done" else (1 if d.get("status") == "error" else 2)


def cmd_only_logs(cfg, tail: int, search: str | None, since: str | None):
    need(cfg, "url", "key", "app")
    # Grep client-side: server-side `search=` returns HTTP 500 when docker's
    # `grep` exits non-zero on no match, which Dokploy surfaces as an error.
    params = {"applicationId": cfg["app"], "tail": tail}
    if since:
        params["since"] = since
    code, logs = api("GET", cfg["url"], "/application.readLogs", cfg["key"], params=params)
    if code >= 300:
        print(f"logs failed: HTTP {code} {logs}", file=sys.stderr)
        return 1
    print(filter_local(logs if isinstance(logs, str) else fmt(logs), search))
    return 0


def cmd_db_logs(cfg, tail: int, search: str | None):
    need(cfg, "url", "key", "postgres")
    params = {"postgresId": cfg["postgres"], "tail": tail}
    code, logs = api("GET", cfg["url"], "/postgres.readLogs", cfg["key"], params=params)
    if code >= 300:
        print(f"db-logs failed: HTTP {code} {logs}", file=sys.stderr)
        return 1
    print(filter_local(logs if isinstance(logs, str) else fmt(logs), search))
    return 0


def cmd_inspect(cfg):
    need(cfg, "url", "key", "app")
    code, info = api("GET", cfg["url"], "/application.one", cfg["key"], params={"applicationId": cfg["app"]})
    if code >= 300:
        print(f"inspect failed: HTTP {code} {info}", file=sys.stderr)
        return 1
    keep = {
        k: info.get(k) for k in (
            "applicationId", "name", "appName", "applicationStatus", "sourceType",
            "customGitUrl", "customGitBranch", "buildType", "dockerfile",
            "env", "replicas", "createdAt",
        )
    } if isinstance(info, dict) else info
    print(fmt(keep))
    return 0


def cmd_version():
    vf = SCRIPT_DIR / "VERSION"
    print(vf.read_text().strip() if vf.exists() else "unknown")
    return 0


def cmd_check_update():
    script = SCRIPT_DIR / "skills" / "update_check.py"
    if not script.exists():
        print("update_check.py missing", file=sys.stderr)
        return 1
    return subprocess.run([sys.executable, str(script)]).returncode


def cmd_deploy(cfg, poll_interval: int, poll_timeout: int, log_tail: int):
    need(cfg, "url", "key", "app")
    print(f"→ Dokploy {cfg['url']}  app={cfg['app']}")
    code, resp = api("POST", cfg["url"], "/application.deploy", cfg["key"], body={"applicationId": cfg["app"]})
    if code >= 300:
        print(f"deploy trigger failed: HTTP {code} {resp}", file=sys.stderr)
        return 1
    print(f"✓ deploy triggered (HTTP {code})")

    t0 = time.time()
    last_id = last_status = None
    while time.time() - t0 < poll_timeout:
        code, deps = api("GET", cfg["url"], "/deployment.all", cfg["key"], params={"applicationId": cfg["app"]})
        if code >= 300 or not isinstance(deps, list) or not deps:
            time.sleep(poll_interval)
            continue
        d = deps[0]
        did, st = d.get("deploymentId"), d.get("status")
        if did != last_id or st != last_status:
            elapsed = int(time.time() - t0)
            print(f"  [{elapsed:>3}s] {did} → {st}", flush=True)
            last_id, last_status = did, st
        if st in ("done", "error"):
            print(f"\n=== Final: status={st} ===")
            if st == "error":
                err = d.get("errorMessage") or "(no errorMessage)"
                print(f"errorMessage:\n{err}")
                print(f"\nlogPath (on Dokploy host):\n  {d.get('logPath')}")
            print(f"\n--- runtime logs (tail={log_tail}) ---")
            code, logs = api("GET", cfg["url"], "/application.readLogs", cfg["key"],
                             params={"applicationId": cfg["app"], "tail": log_tail})
            print(f"(readLogs failed HTTP {code}: {logs})" if code >= 300 else fmt(logs))
            return 0 if st == "done" else 1
        time.sleep(poll_interval)
    print(f"TIMEOUT after {poll_timeout}s — last status={last_status}", file=sys.stderr)
    return 3


def main():
    ap = argparse.ArgumentParser(description="Dokploy deploy + poll + logs")
    ap.add_argument("--url", help="Dokploy base URL, e.g. http://host:3000")
    ap.add_argument("--key", help="x-api-key value")
    ap.add_argument("--app", help="applicationId")
    ap.add_argument("--postgres", help="postgresId (for --db-logs)")
    ap.add_argument("--poll-interval", type=int, default=3)
    ap.add_argument("--poll-timeout", type=int, default=900)
    ap.add_argument("--log-tail", type=int, default=80)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--only-status", action="store_true")
    g.add_argument("--only-logs", action="store_true")
    g.add_argument("--db-logs", action="store_true")
    g.add_argument("--inspect", action="store_true")
    g.add_argument("--list", dest="list_", action="store_true")
    g.add_argument("--version", action="store_true")
    g.add_argument("--check-update", dest="check_update", action="store_true")
    ap.add_argument("--search", help="filter log lines (client-side regex, case-insensitive)")
    ap.add_argument("--since", help="readLogs `since` e.g. 10m, 1h (runtime logs only)")
    args = ap.parse_args()

    if args.version:
        sys.exit(cmd_version())
    if args.check_update:
        sys.exit(cmd_check_update())

    cfg = resolve_config(args)
    if args.list_:
        sys.exit(cmd_list(cfg))
    if args.only_status:
        sys.exit(cmd_only_status(cfg))
    if args.only_logs:
        sys.exit(cmd_only_logs(cfg, args.log_tail, args.search, args.since))
    if args.db_logs:
        sys.exit(cmd_db_logs(cfg, args.log_tail, args.search))
    if args.inspect:
        sys.exit(cmd_inspect(cfg))
    sys.exit(cmd_deploy(cfg, args.poll_interval, args.poll_timeout, args.log_tail))


if __name__ == "__main__":
    main()
