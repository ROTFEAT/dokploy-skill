#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")" && pwd -P)"

case "${1:-}" in
  --version)
    cat "$REPO/VERSION" 2>/dev/null || echo unknown
    ;;
  --check-update)
    shift
    exec python3 "$REPO/skills/update_check.py" "$@"
    ;;
  *)
    exec python3 "$REPO/scripts/dokploy_api.py" "$@"
    ;;
esac
